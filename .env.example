# ---- App ----
APP_ENV=development
SECRET_KEY=dummy_change_this_secret_key_to_a_long_random_string_0123456789
ACCESS_TOKEN_MINUTES=720

# ---- Database ----
# Local dev: SQLite. Production: Supabase Postgres (use the pooled/transaction connection string, port 6543).
DATABASE_URL=sqlite:///./local.db
# DATABASE_URL=postgresql://postgres.dummyref:dummy_password@aws-0-dummy.pooler.supabase.com:6543/postgres?sslmode=require

# ---- Optional LLM (rules work without any LLM provider) ----
# LLM_PROVIDER: none | ollama | openai_compatible
# For hosted OpenAI-compatible providers, set LLM_BASE_URL, LLM_API_KEY, and provider-supported model names.
LLM_PROVIDER=none
LLM_API_KEY=dummy_api_key
LLM_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_MODEL_PRIMARY=Qwen/Qwen2.5-7B-Instruct
LLM_MODEL_FALLBACK=mistralai/Mistral-7B-Instruct-v0.3
# For Ollama use:  LLM_MODEL_PRIMARY=qwen2.5:7b-instruct   LLM_MODEL_FALLBACK=mistral:7b-instruct
LLM_MAX_TOKENS=120
LLM_TIMEOUT_SECONDS=12

# ---- External APIs (dummy keys: features report "not configured" until real keys are added) ----
GOOGLE_PLACES_API_KEY=dummy_google_places_key
YELP_API_KEY=dummy_yelp_key
SPOONACULAR_API_KEY=dummy_spoonacular_key
REDDIT_CLIENT_ID=dummy_reddit_client_id
REDDIT_CLIENT_SECRET=dummy_reddit_client_secret
REDDIT_USER_AGENT=voice-food-bot/1.0

# ---- Performance / load ----
RATE_LIMIT_PER_MIN=40
AUTH_RATE_LIMIT_PER_MIN=30
CACHE_TTL_SECONDS=300
# Optional Upstash Redis REST credentials for shared cache/rate limits across Vercel instances.
# Leave blank to use the local in-process fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SESSION_TTL_MINUTES=60
# Turn on during big events (e.g. IPL matches): longer caches, LLM only for understanding
PEAK_MODE=false

# ---- Monitoring / telemetry (OpenTelemetry) ----
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=voice-food-ordering-chatbot
OTEL_CONSOLE=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
